{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// Node subpath-import alias from package.json ("imports"); kit 3's
		// generated tsconfig leaves `paths` empty, so spell it out here.
		"paths": {
			"#lib": ["./src/lib/index.js"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
